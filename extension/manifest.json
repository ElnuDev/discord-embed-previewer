{
  "name": "Discord Embeds",
  "version": "1.1.1",
  "description": "Preview sites' Discord embeds for debugging purposes. Not affiliated in any way with Discord.",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*", "file:///*.html"],
      "js": ["meta-reader.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "discord-embed-previewer@elnu.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "manifest_version": 3
}
